# TortoiseBots configuration.
# Install as tortoise_bots.conf in the module config directory when enabling
# the native module.

[TortoiseBotsConf]

# Optional lifecycle regression test. The character must already exist.
TortoiseBots.AutoTest = 0
TortoiseBots.AutoTest.AccountId = 0
TortoiseBots.AutoTest.CharacterGuid = 0

# Fresh packet/event bridge journey. Uses two existing same-account
# characters, emits a native group invite/accept, exercises master incoming
# and outgoing packet delivery, then removes both headless fixtures.
TortoiseBots.PacketBridgeTest = 0
TortoiseBots.PacketBridgeTest.AccountId = 0
TortoiseBots.PacketBridgeTest.MasterGuid = 0
TortoiseBots.PacketBridgeTest.BotGuid = 0

# Optional AddBot -> immediate RemoveBot queue regression test.
TortoiseBots.PendingAddRemoveTest = 0
TortoiseBots.PendingAddRemoveTest.AccountId = 0
TortoiseBots.PendingAddRemoveTest.CharacterGuid = 0

# Module diagnostics.
TortoiseBots.LogLevel = 1
